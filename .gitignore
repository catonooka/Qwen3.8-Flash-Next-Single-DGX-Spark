# Allowlist. Everything is ignored; only the files a fresh clone needs in
# order to run are re-included below. Add new run files here explicitly.
*

# Descend into directories so the rules below can match inside them.
# (Git tracks files, not directories, so this adds nothing by itself.)
!*/

# --- github metadata ---------------------------------------------------
!/.github/FUNDING.yml
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/ISSUE_TEMPLATE/1_bug.md
!/.github/ISSUE_TEMPLATE/2_improvement.md
!/.github/ISSUE_TEMPLATE/3_feature_request.md

# --- top level ---------------------------------------------------------
!/.gitignore
!/LICENSE
!/README.md
!/CHANGELOG.md
# the serving profile. /.env itself stays ignored: it may hold HF_TOKEN.
!/.env.sample
!/download.sh
!/start.sh
!/stop.sh

# --- launcher support and patch generators -----------------------------
!/files/memwatch.sh
!/files/build_ple_packed_table.py
!/files/patch_ple_layer.py
!/files/patch_modelopt_mxfp8.py
!/files/patch_ple_offload.py
!/files/patch_qsa_fp8_kv.py
!/files/patch_mtp_draft_vocab.py
# shipped reduced draft vocabulary (47,149 ids, code-tuned). The 65k en+code
# vocab the +25% decode win was measured with is a generated artifact and is
# not tracked; this smaller file makes the default path work out of the box.
!/files/draft_vocab_en_code_47k.txt
# builds the reduced draft vocabulary the MTP patch reads. Its output is a
# generated artifact and lives in ~/.cache/vllm/draft_vocab/, not here.
!/files/build_draft_vocab.py
# recommended kernel VM tunables (not applied by anything here)
!/files/sysctl-spark3.conf

# --- benchmark harness (2026-09-05/06 overnight sweep) ------------------
# The published numbers are sparkDash's; these drive sparkDash one
# concurrency level at a time and read the vLLM counters around each level,
# which is what makes ms/step and tokens/step comparable across launches.
!/bench/sweep.py
!/bench/mixed.py

# --- perf-campaign additions (2026-09-07) ---
!/files/mamba_utils_50729.py
!/skinny/Dockerfile.skinny-gemm
!/skinny/patch-skinny-gemm-tp1.py
!/bench/prefill_ladder.py
!/bench/warmturn.py
!/bench/longctx_decode.py

# --- 2026-09-12 C1-80 campaign ---
# standing-stack relauncher (A/B switch), prose bench, sparkDash client,
# F4a-lite draft top-K patch, #54048 router port, INT8 head probe, research4 corpus
!/relaunch.sh
!/bench/bench_prose.py
!/bench/sd_bench.py
!/files/mtp_patched_topk.py
!/files/gate_linear.py
!/int8_head_bench.py
!/research4/arxiv-techniques.md
!/research4/community-github.md
!/research4/cuda-system.md
!/s3/slice53388.py
!/s3/out53388/vllm/config/speculative.py
!/s3/out53388/vllm/v1/core/kv_cache_utils.py
!/s3/out53388/vllm/v1/core/sched/scheduler.py
!/s3/out53388/vllm/v1/core/single_type_kv_cache_manager.py
!/s3/out53388/vllm/v1/simple_kv_offload/manager.py
!/s3/out53388/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py

# --- measurement write-ups ---------------------------------------------
# Host-specific, but they carry the numbers the README and CHANGELOG cite.
!/docs/synthesis-astra-fable-2026-09-05.md
!/docs/overnight-2026-09-05.md
!/docs/goal-overnight-2026-09-05.md
!/docs/perf-campaign-2026-09-07.md

# Deliberately NOT tracked:
#   bench/*                   the rest of the local benchmark scripts
#   .env                      may contain HF_TOKEN
#   HANDOFF.md, docs/*        the rest of the host-specific notes
#   logs/, *.log              runtime output
#   .last_launch.sh           regenerated by start.sh --no-launch
#   files/*.orig,             upstream vLLM sources; start.sh extracts them
#   files/ple_offload/orig/     from the image on first run
#   files/ple_layer_patched.py, files/modelopt_patched.py,
#   files/mtp_patched.py,
#   files/ple_offload/*.py    generated from the .orig copies on every launch
